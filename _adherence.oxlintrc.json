{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/data/**",
              "components/feedback/**",
              "components/layout/**",
              "motion.js",
              "motion2.js",
              "site.js",
              "tweaks.js",
              "ui_kits/jrunner-app/**",
              "ui_kits/xell-customizer/**",
              "xfall.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Web437 IBM VGA))/i]",
        "message": "Font not provided by the design system. Available: Web437 IBM VGA."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|block|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, block, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|danger)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, disabled, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|mono|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, label, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='DeviceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|detail|empty|height|style|key|ref|className|style|children)$/]",
        "message": "<DeviceCard> doesn't accept that prop. Declared props: image, name, detail, empty, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlashOverlay'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|caption|hint|logo|size|style|key|ref|className|style|children)$/]",
        "message": "<FlashOverlay> doesn't accept that prop. Declared props: value, max, caption, hint, logo, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<GroupBox> doesn't accept that prop. Declared props: title, children, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|severity|key|ref|className|style|children)$/]",
        "message": "<LogLine> doesn't accept that prop. Declared props: text, severity."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogLine'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:ok|info|warn|error|plain|muted)$/]",
        "message": "<LogLine> severity must be one of 'ok' | 'info' | 'warn' | 'error' | 'plain' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuDropdownItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|submenu|key|ref|className|style|children)$/]",
        "message": "<MenuDropdownItem> doesn't accept that prop. Declared props: label, submenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|kind|onYes|onNo|onOk|width|style|key|ref|className|style|children)$/]",
        "message": "<MessageDialog> doesn't accept that prop. Declared props: title, message, kind, onYes, onNo, onOk, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageDialog'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:ok|yesno)$/]",
        "message": "<MessageDialog> kind must be one of 'ok' | 'yesno'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|onChange|width|disabled|style|key|ref|className|style|children)$/]",
        "message": "<NumberField> doesn't accept that prop. Declared props: value, min, max, onChange, width, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|marquee|height|showText|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, marquee, height, showText, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|name|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, onChange, disabled, label, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|labelWidth|value|options|placeholder|onChange|disabled|width|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, labelWidth, value, options, placeholder, onChange, disabled, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SplitButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|onOpen|open|disabled|style|key|ref|className|style|children)$/]",
        "message": "<SplitButton> doesn't accept that prop. Declared props: children, onClick, onOpen, open, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|key|ref|className|style|children)$/]",
        "message": "<StatusBarItem> doesn't accept that prop. Declared props: label, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|children|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange, children, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|labelWidth|value|placeholder|readOnly|disabled|mono|onChange|width|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, labelWidth, value, placeholder, readOnly, disabled, mono, onChange, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:menu|activeMenu|onMenu|right|onMinimize|onClose|logo|style|key|ref|className|style|children)$/]",
        "message": "<TitleBar> doesn't accept that prop. Declared props: menu, activeMenu, onMenu, right, onMinimize, onClose, logo, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
