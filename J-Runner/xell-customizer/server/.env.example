# Copy this file to .env and fill in a GitHub personal access token with permission to
# dispatch workflows on the xell-worker/xell-builder repo (the same repo the original
# Cloudflare-hosted xell-customizer-api targets - this port doesn't change where XeLL
# actually gets built, only where the dispatcher runs).
GITHUB_TOKEN=

# Optional - defaults to 2222.
PORT=2222
