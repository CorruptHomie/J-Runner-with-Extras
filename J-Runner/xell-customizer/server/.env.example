# GitHub personal access token with the "workflow" scope.
GITHUB_TOKEN=

# Which repo hosts the XeLL build workflow.
#
# The upstream default below only accepts workflow dispatches from tokens with write
# access to it - a personal token will get "Resource not accessible by personal access
# token" (HTTP 403). To use this with your own token, fork
# https://github.com/xell-worker/xell-builder and point these at your fork:
#
#   GITHUB_OWNER=your-github-username
#   GITHUB_REPO=xell-builder
GITHUB_OWNER=xell-worker
GITHUB_REPO=xell-builder
GITHUB_WORKFLOW=build.yml
GITHUB_REF=main

# Where a finished build is unpacked. Defaults to J-Runner's common\xell folder, so a
# generated XeLL lands where J-Runner already reads XeLL from.
# XELL_OUTPUT_DIR=

# Optional - defaults to 2222.
PORT=2222
